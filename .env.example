# Primary LLM Provider (e.g., Groq)
PRIMARY_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_API_KEY=your-groq-api-key-here
PRIMARY_MODEL=llama-3.3-70b-versatile

# Fallback LLM Provider (e.g., Google Gemini via OpenAI-compatible endpoint)
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_API_KEY=your-gemini-api-key-here
FALLBACK_MODEL=gemini-2.0-flash

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
